{
  "entities": {
    "bank_accounts": {
      "title": "Bank Account",
      "description": "Family and personal bank accounts for Anson and Dona",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumberMasked": { "type": "string" },
        "owner": { "type": "string", "enum": ["Anson", "Dona", "Joint"] },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "colorTheme": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "bankName", "owner", "currentBalance"]
    },
    "cash_wallets": {
      "title": "Cash Wallet",
      "description": "Cash in hand wallets for Anson and Dona",
      "type": "object",
      "properties": {
        "owner": { "type": "string", "enum": ["Anson", "Dona"] },
        "balance": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["owner", "balance"]
    },
    "loans": {
      "title": "Loan",
      "description": "Loans and EMIs tracked by Anson and Dona",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "owner": { "type": "string", "enum": ["Anson", "Dona"] },
        "originalAmount": { "type": "number" },
        "outstandingPrincipal": { "type": "number" },
        "monthlyEmi": { "type": "number" },
        "interestRate": { "type": "number" },
        "startDate": { "type": "string" },
        "emiDueDay": { "type": "number" },
        "emiDueDate": { "type": "string" },
        "paymentFrequency": { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
        "totalInterest": { "type": "number" },
        "quarterlyInterest": { "type": "number" },
        "initialPaidAmount": { "type": "number" },
        "tenureMonths": { "type": "number" },
        "emisPaid": { "type": "number" },
        "emisRemaining": { "type": "number" },
        "lenderName": { "type": "string" },
        "linkedAccountId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] }
      },
      "required": ["id", "name", "owner", "monthlyEmi", "outstandingPrincipal"]
    },
    "transactions": {
      "title": "Transaction",
      "description": "Financial transactions including income, expense, transfers, and EMI payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "transfer", "emi_payment"] },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "person": { "type": "string", "enum": ["Anson", "Dona"] },
        "category": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "fromAccountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "fromCashPerson": { "type": "string" },
        "toCashPerson": { "type": "string" },
        "notes": { "type": "string" },
        "receiptImage": { "type": "string" },
        "loanId": { "type": "string" },
        "paymentFrequency": { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
        "interestAmount": { "type": "number" },
        "transferType": { "type": "string" },
        "createdByDevice": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "amount", "date", "person"]
    },
    "custom_categories": {
      "title": "Custom Category",
      "description": "User created custom categories for expenses and income",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "category_colors": {
      "title": "Category Color",
      "description": "Custom color assignments for expense categories",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "color": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["category", "color"]
    },
    "users": {
      "title": "User Profile",
      "description": "Profiles and PIN security for Anson and Dona",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarBg": { "type": "string" },
        "pin": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "category_budgets": {
      "title": "Category Budget",
      "description": "Monthly spending limits per category for family, Anson, or Dona",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "scope": { "type": "string", "enum": ["Family", "Anson", "Dona"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "category", "monthlyLimit"]
    },
    "daily_notes": {
      "title": "Daily Note & Calendar Event",
      "description": "Daily doing matters, journey journal notes, birthdays, wedding dates, and special reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["task", "journal", "birthday", "wedding", "special_date"] },
        "date": { "type": "string" },
        "reminderTime": { "type": "string" },
        "reminderEnabled": { "type": "boolean" },
        "remindDaysBefore": { "type": "number" },
        "repeatYearly": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "completedBy": { "type": "string", "enum": ["Anson", "Dona"] },
        "person": { "type": "string", "enum": ["Anson", "Dona"] },
        "createdByDevice": { "type": "string" },
        "updatedByDevice": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "type", "date", "reminderEnabled", "completed", "person"]
    },
    "health_insurance": {
      "title": "Health Insurance Policy",
      "description": "Family and individual health insurance policies with monthly EMI setup and renewal tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "policyName": { "type": "string" },
        "insurer": { "type": "string" },
        "policyNumber": { "type": "string" },
        "coveredMembers": { "type": "string" },
        "sumInsured": { "type": "number" },
        "monthlyEmi": { "type": "number" },
        "annualPremium": { "type": "number" },
        "paymentFrequency": { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
        "emiDueDay": { "type": "number" },
        "emiDueDate": { "type": "string" },
        "startDate": { "type": "string" },
        "renewalDate": { "type": "string" },
        "owner": { "type": "string", "enum": ["Anson", "Dona", "Family"] },
        "linkedAccountId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "policyName", "insurer", "monthlyEmi", "paymentFrequency", "emiDueDay", "owner", "status"]
    },
    "borrow_lend_records": {
      "title": "Borrow & Lend Record",
      "description": "Money lent to others (to receive) and money borrowed from others (to pay back) with partial repayment history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["lend", "borrow"] },
        "personName": { "type": "string" },
        "phone": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "handledBy": { "type": "string", "enum": ["Anson", "Dona"] },
        "status": { "type": "string", "enum": ["pending", "settled"] },
        "notes": { "type": "string" },
        "reminderEnabled": { "type": "boolean" },
        "payments": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "personName", "amount", "paidAmount", "date", "handledBy", "status"]
    }
  },
  "firestore": {
    "/category_budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/category_budgets" },
      "description": "Monthly spending limits for expense categories"
    },
    "/daily_notes/{noteId}": {
      "schema": { "$ref": "#/entities/daily_notes" },
      "description": "Daily notes, tasks, journey entries, birthdays, wedding dates and reminders"
    },
    "/health_insurance/{policyId}": {
      "schema": { "$ref": "#/entities/health_insurance" },
      "description": "Health insurance policies and monthly EMI schedules"
    },
    "/borrow_lend_records/{recordId}": {
      "schema": { "$ref": "#/entities/borrow_lend_records" },
      "description": "Borrowing and lending money records and repayments"
    }
  }
}
